{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenDash",
  "version": "1.11.0",
  "identifier": "com.zhangferry-dev.tokendash",
  "build": {
    "frontendDist": "webview",
    "devUrl": "http://localhost:5173/menubar.html"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "AI coding token usage in the system tray",
    "longDescription": "TokenDash shows today's AI coding token usage and cost in the system tray, with a popover panel for hourly activity, model and project breakdown, trend and Coding Plan quotas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "gen/server": "server"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
